{
  "name": "@fibricheck/react-native-camera-sdk",
  "title": "React Native Fibricheck",
  "version": "1.4.0",
  "description": "React Native FibriCheck",
  "main": "build/src/index.js",
  "types": "build/types/src/index.d.ts",
  "scripts": {
    "add-suffix": "add-suffix",
    "remove-suffix": "remove-suffix",
    "start": "react-native start",
    "android": "tsc && react-native run-android",
    "clear": "rm -rf $TMPDIR/react-native-packager-cache-* && rm -rf $TMPDIR/metro-bundler-cache-*",
    "fresh-start": "watchman watch-del-all && rm -rf $TMPDIR/react-native-packager-cache-* && rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf node_modules/ && npm cache clean --force && npm install && npm run start-clear-cache",
    "start-clear-cache": "react-native start --reset-cache",
    "ios": "tsc && react-native run-ios",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint-fix": "yarn lint --quiet --fix",
    "publish:dev": "yarn publish --tag dev",
    "test": "jest"
  },
  "files": [
    "build",
    "ios",
    "android",
    "react-native-camera-sdk.podspec"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fibricheck/react-native-camera-sdk.git",
    "baseUrl": "https://github.com/fibricheck/react-native-camera-sdk.git"
  },
  "keywords": [
    "react-native"
  ],
  "author": "Qompium",
  "readmeFilename": "README.md",
  "peerDependencies": {
    "react-native": ">=0.73.0 <1.0.x"
  },
  "yalcSig": "a20e816eb77693bed8c8ef6aefc3115a"
}
